{
  "name": "petcare",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @petcare/api",
    "dev:web": "npm run dev -w @petcare/web",
    "migrate": "npm run migrate -w @petcare/api",
    "provision": "npm run provision -w @petcare/api",
    "seed:demo": "npm run seed:demo -w @petcare/api",
    "seed:reset": "npm run seed:demo -w @petcare/api -- --reset"
  }
}
